
#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *next;
};

int main()
{
    struct node *head1 = NULL, *head2 = NULL;
    struct node *temp, *newnode;
    int n, i;

    printf("Enter number of nodes in first list: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        newnode = (struct node*)malloc(sizeof(struct node));

        printf("Enter data: ");
        scanf("%d", &newnode->data);

        newnode->next = NULL;

        if(head1 == NULL)
            head1 = temp = newnode;
        else
        {
            temp->next = newnode;
            temp = newnode;
        }
    }

    printf("Enter number of nodes in second list: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        newnode = (struct node*)malloc(sizeof(struct node));

        printf("Enter data: ");
        scanf("%d", &newnode->data);

        newnode->next = NULL;

        if(head2 == NULL)
            head2 = temp = newnode;
        else
        {
            temp->next = newnode;
            temp = newnode;
        }
    }

    if(head1 == NULL)
        head1 = head2;
    else
    {
        temp = head1;

        while(temp->next != NULL)
            temp = temp->next;

        temp->next = head2;
    }

    printf("Concatenated List: ");

    temp = head1;

    while(temp != NULL)
    {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }

    printf("NULL");

    return 0;
}
