#include<stdio.h>
#define SIZE 5

int A[SIZE];
int front = -1;
int rear = -1;

int isFull() {
    if ((rear + 1) % SIZE == front)
        return 1;
    else
        return 0;
}

int isEmpty() {
    if (front == -1 && rear == -1)
        return 1;
    else
        return 0;
}

void enqueue() {
    int x;
    if (isFull()) {
        printf("OVERFLOWING\n");
    } else {
        printf("Enter elements: ");
        scanf("%d", &x);

        if (isEmpty()) {
            front = 0;
            rear = 0;
        } else {
            rear = (rear + 1) % SIZE;
        }
        A[rear] = x;
    }
}

void dequeue() {
    if (isEmpty()) {
        printf("UNDERFLOW\n");
    } else {
        printf("Deleted %d\n", A[front]);
        if (front == rear) {
            front = -1;
            rear = -1;
        } else {
            front = (front + 1) % SIZE;
        }
    }
}

void display() {
    if (isEmpty()) {
        printf("UNDERFLOW\n");
    } else {
        printf("Queue elements: ");
        int i = front;
        while (1) {
            printf("%d ", A[i]);
            if (i == rear) {
                break;
            }
            i = (i + 1) % SIZE;
        }
        printf("\n");
    }
}

int main() {
    int choice;
    while (1) {
        printf("\n 1. Enqueue");
        printf("\n 2. Dequeue");
        printf("\n 3. Display");
        printf("\n 4. Exit");
        printf("\nEnter the choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1: enqueue(); break;
            case 2: dequeue(); break;
            case 3: display(); break;
            case 4: return 0;
            default: printf("Invalid choice!\n");
        }
    }
    return 0;
}
